# Copy this file to .env and fill in your values
# Never commit .env to version control

# Backend API base URL
# Android emulator: http://10.0.2.2:3000
# Physical device: http://<your-local-ip>:3000
# Production: https://your-api-domain.com
API_BASE_URL=http://10.0.2.2:3000

# Stripe publishable key (get from https://dashboard.stripe.com/apikeys)
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXX

# Mapbox access token (get from https://account.mapbox.com)
MAPBOX_TOKEN=pk.eyXXXXXXXXXXXXXX

# Login screen illustration URL
LOGIN_IMAGE_URL=https://img.freepik.com/free-vector/mobile-login-concept-illustration_114360-83.jpg?w=740
